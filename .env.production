# Build de demonstracao (Vercel) - a camada de mocks vai junto: nao existe
# backend real neste projeto, entao o deploy roda com os mocks ligados.
VITE_API_BASE_URL=/api

# Origem dedicada ao Socket.IO simulado, interceptada pelo MSW (sem servidor real).
VITE_SOCKET_URL=http://realtime.kurio.mock

VITE_ENABLE_MOCKS=true
