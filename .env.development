# Desenvolvimento - mocks sempre ligados (`pnpm dev`).
VITE_API_BASE_URL=/api

# Origem dedicada ao Socket.IO simulado. Nao existe servidor real nesse endereco:
# o MSW intercepta a conexao no construtor do WebSocket, antes de qualquer DNS.
# Usar uma origem propria (e nao a da pagina) evita colidir com o WebSocket de
# HMR do Vite, que tambem roda na origem local.
VITE_SOCKET_URL=http://realtime.kurio.mock

VITE_ENABLE_MOCKS=true
