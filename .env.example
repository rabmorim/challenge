# Variaveis de ambiente do cliente (prefixo VITE_). Nenhum segredo aqui:
# o backend inteiro e simulado pelo MSW.

# URL base da API REST consumida pela instancia unica do Axios.
VITE_API_BASE_URL=/api

# Origem do servidor Socket.IO. No ambiente de mocks nao existe servidor real
# nesse endereco - o MSW intercepta a conexao no construtor do WebSocket.
# Manter uma origem propria evita colidir com o WebSocket de HMR do Vite.
VITE_SOCKET_URL=http://realtime.kurio.mock

# Liga a camada de mocks. "true" ativa; qualquer outro valor desliga.
VITE_ENABLE_MOCKS=true

# Cenario de mocks aplicado no boot. Vazio = "default" (ou o que vier na URL,
# via ?scenario=<id>). Ids em src/mocks/scenarios/registry.ts.
VITE_MOCK_SCENARIO=

# Timeout (ms) das requisicoes REST. Vazio usa o padrao do app (15000). Os
# testes reduzem este valor para exercitar o cenario de timeout de pedido.
VITE_REQUEST_TIMEOUT_MS=
